# --------------------
# 기본 설정
# --------------------
* text=auto eol=lf

# --------------------
# Python
# --------------------
*.py text eol=lf
*.pyi text eol=lf

# --------------------
# 설정 / 문서
# --------------------
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.env text eol=lf

# --------------------
# 쉘 / 스크립트
# --------------------
*.sh text eol=lf
*.bash text eol=lf

# Windows 전용 스크립트 (개행 유지)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# --------------------
# JSON / 기타
# --------------------
*.json text eol=lf
*.txt text eol=lf

# --------------------
# 바이너리 파일 (diff/변경 추적 안 함)
# --------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

*.pdf binary
*.zip binary
*.tar binary
*.gz binary

*.db binary
*.sqlite binary
